# Bu dosyayi .env olarak kopyalayip doldurun. Gercek degerleri commit etmeyin.
# Bos birakilanlarin cogu kodda varsayilan degere duser (parantez icinde).

# --- Veritabani / Kuyruk ---
DATABASE_URL=
REDIS_URL=                # (redis://localhost:6379)

# --- Ollama (LLM) ---
OLLAMA_HOST=              # (http://localhost:11434)
OLLAMA_MODEL=             # (llama3.1:8b)
OLLAMA_TIMEOUT_MS=        # (5000)

# --- Gateway ---
GATEWAY_PORT=             # (3001)
GATEWAY_NODE_ID=          # (gateway-1)
GATEWAY_URL=              # (http://localhost:3001)
RATE_LIMIT_MAX=           # (100)
LOG_LEVEL=                # (info)

# --- Command ---
COMMAND_PORT=             # (3002)

# --- Agents ---
CLUSTER_RADIUS_M=         # (50)
CLUSTER_TIME_MS=          # (1800000)
DEMO_MODE=
NODE_ENV=

# --- Dashboard / Mobil (Vite, tarayiciya gomulur - gizli deger koymayin) ---
VITE_GATEWAY_URL=
VITE_COMMAND_URL=
VITE_WS_URL=
